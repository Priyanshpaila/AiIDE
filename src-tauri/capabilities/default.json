{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "fs:scope-appdata-recursive",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }, { "path": "*/**" }, { "path": "*:\\**" }, { "path": "**\\*" }, { "path": "\\\\?\\**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }, { "path": "*/**" }, { "path": "*:\\**" }, { "path": "**\\*" }, { "path": "\\\\?\\**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }, { "path": "*/**" }, { "path": "*:\\**" }, { "path": "**\\*" }, { "path": "\\\\?\\**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }, { "path": "*/**" }, { "path": "*:\\**" }, { "path": "**\\*" }, { "path": "\\\\?\\**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }, { "path": "*/**" }, { "path": "*:\\**" }, { "path": "**\\*" }, { "path": "\\\\?\\**" }]
    },
    "upload:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bin/llama-server",
          "sidecar": true,
          "args": true
        },
        {
          "name": "bin/whisper-server",
          "sidecar": true,
          "args": true
        },
        {
          "name": "node",
          "cmd": "node",
          "args": true
        },
        {
          "name": "python",
          "cmd": "python",
          "args": true
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "bin/llama-server",
          "sidecar": true,
          "args": true
        },
        {
          "name": "bin/whisper-server",
          "sidecar": true,
          "args": true
        },
        {
          "name": "node",
          "cmd": "node",
          "args": true
        },
        {
          "name": "python",
          "cmd": "python",
          "args": true
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        }
      ]
    }
  ]
}
